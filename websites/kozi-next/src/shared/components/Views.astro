---
// "Pick your view": the night skyline with its landmarks; choose one to see it from a real
// Kozi window, and which suites look out on it.
import { buildSkyline, VB } from '@shared/lib/skyline';
import { skyState, atClock } from '@shared/lib/sun';
import { skyVars } from '@shared/scripts/sky';
import { LANDMARKS, VIEW_PHOTOS } from '@shared/data/kozi';
import { suitePath, type Building, type Suite } from '@shared/lib/content';
import Photo from './Photo.astro';
// list: the Kuala Lumpur suites, from the content
interface Props { list: { s: Suite; b: Building }[] }
const { list } = Astro.props;

const sky = buildSkyline(7, { id: 'views' });
const night = skyVars(skyState(atClock(21.5)));
const style = Object.entries(night).map(([k, v]) => `${k}:${v}`).join(';');
const at = Object.fromEntries(sky.landmarks.map((l) => [l.id, l]));
---
<section class="vw" data-views data-sel="petronas" aria-labelledby="vw-h" style={style}>
  <div class="wrap vw-top">
    <div class="vw-copy">
      <p class="eyebrow eyebrow-light" data-reveal>Book the view</p>
      <h2 id="vw-h" class="display h2" data-split>Pick your <em>view.</em></h2>
      <p class="lede" data-reveal>Kuala Lumpur's landmarks are right outside. Choose the one you want to wake up to, and we'll show you the suites that look out on it.</p>
      <div class="vw-tabs" role="tablist" aria-label="Landmarks" data-reveal>
        {LANDMARKS.map((l, i) => (
          <button type="button" role="tab" id={`vw-tab-${l.id}`} aria-controls={`vw-panel-${l.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-mark={l.id}>
            <b>{l.name}</b><small>{l.line}</small>
          </button>
        ))}
        <span class="vw-ind" aria-hidden="true"></span>
      </div>
    </div>
    <div class="vw-panels" data-reveal>
      {LANDMARKS.map((l, i) => {
        const shots = VIEW_PHOTOS[l.id];
        const suites = list.filter(({ s }) => s.views.includes(l.id));
        return (
          <div class="vw-panel" role="tabpanel" id={`vw-panel-${l.id}`} aria-labelledby={`vw-tab-${l.id}`} data-panel={l.id} hidden={i !== 0}>
            <figure class="vw-window">
              <Photo k={shots[0].key} alt={shots[0].alt} sizes="(max-width: 860px) 92vw, 46vw" />
              <figcaption><span class="vw-live" aria-hidden="true"></span>{shots[0].from}</figcaption>
            </figure>
            {suites.length > 0 && <p class="vw-suites"><span>Suites with this view</span>
              {suites.map(({ s, b }) => <a href={suitePath(b, s)}>{s.name} <span aria-hidden="true">→</span></a>)}
            </p>}
          </div>
        );
      })}
    </div>
  </div>
  <div class="vw-city" aria-hidden="true">
    <div class="city-box vw-box">
      <Fragment set:html={sky.svg} />
      {LANDMARKS.map((l) => {
        const m = at[l.id];
        const f = (m.top / VB.h) * 100;
        return <span class="vw-beam" data-beam={l.id} style={`left:${((m.x / VB.w) * 100).toFixed(2)}%;bottom:${(f * 0.5).toFixed(2)}%;height:${(f * 0.9).toFixed(2)}%`}></span>;
      })}
    </div>
  </div>
</section>

<style is:global>
  .vw { position: relative; background: linear-gradient(to bottom, #070914 0%, #0d1330 46%, #1d2650 100%); color: var(--cream); padding-top: clamp(96px, 12vw, 180px); overflow: hidden; container-type: inline-size; }
  .vw .lede { color: rgb(246 239 228 / 0.74); }
  .eyebrow-light { color: var(--amber-hi); }
  .vw .display em { color: var(--amber-hi); }
  .vw-top { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(40px, 6vw, 110px); align-items: start; position: relative; z-index: 2; }
  .vw-copy .h2 { margin: 22px 0 22px; }
  .vw-tabs { position: relative; display: grid; margin-top: 36px; border-top: 1px solid rgb(246 239 228 / 0.14); }
  .vw-tabs button { position: relative; display: grid; gap: 4px; text-align: left; padding: 20px 0 20px 26px; border-bottom: 1px solid rgb(246 239 228 / 0.14); color: rgb(246 239 228 / 0.56); transition: color 250ms ease; }
  .vw-tabs button b { font: 400 clamp(22px, 2vw, 30px)/1.1 var(--display); font-variation-settings: var(--soft); letter-spacing: -0.015em; }
  .vw-tabs button small { font-size: 14.5px; line-height: 1.4; }
  .vw-tabs button[aria-selected='true'] { color: var(--cream); }
  .vw-tabs button::before { content: ''; position: absolute; left: 0; top: 50%; width: 8px; height: 8px; margin-top: -4px; border-radius: 50%; box-shadow: inset 0 0 0 1px currentColor; transition: background-color 250ms ease, box-shadow 250ms ease; }
  .vw-tabs button[aria-selected='true']::before { background: var(--amber-hi); box-shadow: 0 0 0 4px rgb(240 184 96 / 0.18); }
  @media (hover: hover) and (pointer: fine) { .vw-tabs button:hover { color: var(--cream); } }
  .vw-ind { display: none; }
  .vw-panels { position: relative; }
  .vw-panel[hidden] { display: none; }
  .vw-window { position: relative; margin: 0; border-radius: 28px; overflow: hidden; aspect-ratio: 4 / 3; background: #0b0e1c;
    box-shadow: 0 40px 100px -40px rgb(0 0 0 / 0.8), inset 0 0 0 1px rgb(255 255 255 / 0.08); }
  .vw-window img { width: 100%; height: 100%; object-fit: cover; }
  .vw-window::after { content: ''; position: absolute; inset: 0; border-radius: inherit; box-shadow: inset 0 0 0 10px rgb(10 12 22 / 0.55), inset 0 0 0 11px rgb(255 255 255 / 0.06); pointer-events: none; }
  .vw-window figcaption { position: absolute; left: 22px; bottom: 22px; display: inline-flex; align-items: center; gap: 9px; padding: 9px 14px; border-radius: 999px; font: 600 13px/1 var(--sans);
    background: rgb(10 12 22 / 0.55); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
  .vw-live { width: 7px; height: 7px; border-radius: 50%; background: var(--amber-hi); box-shadow: 0 0 0 3px rgb(240 184 96 / 0.25); }
  .vw-suites { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; margin: 22px 4px 0; font-size: 14.5px; }
  .vw-suites > span { color: rgb(246 239 228 / 0.55); font: 600 11px/1 var(--sans); letter-spacing: 0.18em; text-transform: uppercase; margin-right: 4px; }
  .vw-suites a { font-weight: 600; color: var(--cream); border-bottom: 1px solid rgb(240 184 96 / 0.6); padding-bottom: 2px; }
  .vw-suites a span { display: inline-block; transition: transform 200ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .vw-suites a:hover span { transform: translateX(3px); } }
  .vw-panel.swap .vw-window img { animation: vwswap 520ms var(--ease-out); }
  @keyframes vwswap { from { opacity: 0; filter: blur(8px); transform: scale(1.03); } to { opacity: 1; filter: none; transform: none; } }

  .vw-city { position: relative; height: clamp(300px, 42cqw, 620px); margin-top: clamp(-120px, -6cqw, -40px); container-type: size; pointer-events: none; }
  /* street level: the towers stand on a dark ground lit warm along the road, not cut off at the edge */
  .vw-city::after { content: ''; position: absolute; inset: auto 0 0; height: clamp(26px, 3cqw, 44px); z-index: 1;
    background: linear-gradient(to bottom, rgb(240 184 96 / 0.34), rgb(240 184 96 / 0) 2px), var(--sk4, #0a0d18);
    box-shadow: 0 -22px 46px -14px rgb(240 184 96 / 0.22); }
  .vw-box { --W: max(100cqw, 266.67cqh); }
  .vw .sk-mark { transition: fill 400ms ease; }
  .vw[data-sel='kl-tower'] [data-mark='kl-tower'], .vw[data-sel='merdeka'] [data-mark='merdeka'] { fill: #3a4680; }
  .vw[data-sel='petronas'] .sk-pglow { opacity: 1; }
  .vw:not([data-sel='petronas']) .sk-pglow { opacity: 0.35; transition: opacity 400ms ease; }
  .vw:not([data-sel='petronas']) .sk-plit { opacity: 0.55; }
  .vw-beam { position: absolute; width: 8%; margin-left: -4%; transform-origin: bottom; opacity: 0; transform: scaleY(0.7); mix-blend-mode: screen;
    background: radial-gradient(50% 55% at 50% 62%, rgb(240 184 96 / 0.2), rgb(240 184 96 / 0.06) 55%, transparent 74%); transition: opacity 500ms ease, transform 700ms var(--ease-out); }
  .vw[data-sel='petronas'] [data-beam='petronas'], .vw[data-sel='kl-tower'] [data-beam='kl-tower'], .vw[data-sel='merdeka'] [data-beam='merdeka'] { opacity: 1; transform: none; }
  @media (max-width: 860px) {
    .vw-top { grid-template-columns: 1fr; }
    .vw-box { left: clamp(100cqw - var(--W), 50cqw - 0.5 * var(--W), 0px); }
    .vw-city { height: 300px; margin-top: -10px; }
  }
</style>
