---
// The live hero: the sky over Kuala Lumpur as it is right now (sun, moon, stars and city lights),
// the skyline with Vortex KLCC and our window on it, a greeting for the hour, and the search.
import { buildSkyline, VB } from '@shared/lib/skyline';
import { atClock, skyState, skyWords } from '@shared/lib/sun';
import Search from './Search.astro';

const sky = buildSkyline(7, { id: 'hero' });
const first = skyWords(skyState(atClock(10.5))); // the first paint before the live sky arrives
const pin = { left: ((sky.kozi.x + 3.5) / VB.w) * 100, top: ((sky.kozi.y + 4.5) / VB.h) * 100 };
---
<section class="hero" data-hero aria-labelledby="hero-h">
  <div class="hero-sky" aria-hidden="true"><canvas data-sky></canvas></div>
  <div class="hero-city" data-city>
    <div class="city-box">
      <Fragment set:html={sky.svg} />
      <a class="kozi-pin" href="/kuala-lumpur/vortex-klcc/boutique/" style={`left:${pin.left.toFixed(3)}%;top:${pin.top.toFixed(3)}%`} data-pin>
        <span class="kp-line" aria-hidden="true"></span>
        <span class="kp-label"><b>Kozi @ Vortex KLCC</b><small>Level 43 · Boutique Suite <span aria-hidden="true">→</span></small></span>
      </a>
    </div>
  </div>
  <div class="hero-ground" aria-hidden="true"></div>

  <div class="hero-copy wrap">
    <p class="hero-live" data-enter>
      <span class="live-dot" aria-hidden="true"></span><span data-live-k>Live</span>
      <span class="hl-sep" aria-hidden="true"></span><time data-clock>{first.clock}</time><span class="hl-in">in Kuala Lumpur</span>
    </p>
    <h1 id="hero-h" class="display hero-h">
      <span class="hh-greet" data-greet>{first.greet}</span>
      <span class="hh-city" data-city-name>Kuala Lumpur.</span>
    </h1>
    <p class="hero-line" data-line data-enter>{first.line}</p>
    <div class="hero-times" role="group" aria-label="See Kuala Lumpur at another time of day" data-enter>
      <span class="ht-k">See it at</span>
      <button type="button" data-at="now" aria-pressed="true">Now</button>
      <button type="button" data-at="sunrise" aria-pressed="false">Sunrise</button>
      <button type="button" data-at="midday" aria-pressed="false">Midday</button>
      <button type="button" data-at="golden" aria-pressed="false">Golden hour</button>
      <button type="button" data-at="night" aria-pressed="false">Night</button>
    </div>
  </div>

  <dl class="hero-read" data-enter>
    <div><dt>Kuala Lumpur</dt><dd>3.15° N · 101.71° E</dd></div>
    <div><dt>Sunrise</dt><dd data-rise>{first.sunrise}</dd></div>
    <div><dt>Sunset</dt><dd data-set>{first.sunset}</dd></div>
    <div><dt>Moon</dt><dd data-moon>&nbsp;</dd></div>
  </dl>

  <div class="hero-dock" data-enter><Search id="hero-search" /></div>
</section>

<style is:global>
  .hero {
    --ink-now: var(--ink); --accent-now: var(--amber-deep);
    position: relative; height: 100svh; min-height: 640px; max-height: 1400px; overflow: hidden;
    container-type: size; color: var(--ink-now); isolation: isolate;
    background: linear-gradient(to top, var(--hor) 30%, var(--zen));
    transition: color 700ms ease;
  }
  :root[data-ink='light'] .hero { --ink-now: var(--cream); --accent-now: var(--amber-hi); }
  .js:not(.rm):not(.js-late) .hero:not(.entered) :is([data-enter], .hero-h, .sk-layer, .kozi-pin) { opacity: 0; }
  .hero-sky, .hero-sky canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-sky { z-index: -2; will-change: transform; }
  .hero-sky canvas { opacity: 0; transition: opacity 700ms ease; }
  .hero.gl-on .hero-sky canvas { opacity: 1; }
  .hero.no-gl .hero-sky { display: none; }

  /* The skyline box keeps the drawing's 8:3 shape: it fills the width, or the height on tall
     screens, and on a phone it centres on Vortex and the Twin Towers rather than the middle. */
  .hero-city { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .hero-ground { position: absolute; inset: auto 0 0; height: 26%; z-index: -1; pointer-events: none;
    background: linear-gradient(to top, color-mix(in srgb, var(--sk4) 92%, transparent) 0%, color-mix(in srgb, var(--sk4) 55%, transparent) 38%, transparent); }

  .hero-copy { position: relative; padding-top: calc(var(--hd-h) + clamp(20px, 7cqh, 100px)); }
  .hero-live { display: flex; align-items: center; gap: 10px; margin: 0 0 clamp(14px, 2.4cqh, 26px); font: 600 12px/1 var(--sans); letter-spacing: 0.16em; text-transform: uppercase; }
  .hero-live time { font-variant-numeric: tabular-nums; letter-spacing: 0.08em; }
  .hero-live .hl-in { opacity: 0.72; letter-spacing: 0.12em; }
  .hl-sep { width: 18px; height: 1px; background: currentColor; opacity: 0.5; }
  .hero[data-preview] .live-dot { background: transparent; box-shadow: inset 0 0 0 1.5px currentColor; }
  .hero[data-preview] .live-dot::after { display: none; }

  .hero-h { font-size: min(10.4cqw, 17cqh, 176px); line-height: 0.9; letter-spacing: -0.03em; font-weight: 320; max-width: 6.9em; }
  .hh-greet { display: block; font-size: 0.34em; font-style: italic; font-weight: 340; letter-spacing: -0.012em; line-height: 1.1; margin-bottom: 0.14em; opacity: 0.92; }
  .hh-city { display: block; }
  .hero-line { margin: clamp(14px, 2.6cqh, 28px) 0 0; font-size: clamp(16px, 1.25vw, 19px); line-height: 1.45; max-width: 20.7em; min-height: 1.45em; opacity: 0.88; }

  .hero-times { display: flex; align-items: center; gap: 4px; margin-top: clamp(16px, 2.8cqh, 30px); flex-wrap: wrap; }
  .ht-k { font: 600 11px/1 var(--sans); letter-spacing: 0.18em; text-transform: uppercase; opacity: 0.64; margin-right: 8px; white-space: nowrap; }
  .hero-times button { height: 34px; padding: 0 14px; border-radius: 999px; font: 550 13.5px/1 var(--sans); color: inherit;
    background: color-mix(in srgb, var(--zen) 34%, transparent); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, currentColor 26%, transparent);
    transition: background-color 200ms ease, color 200ms ease, box-shadow 200ms ease, transform 160ms var(--ease-out); }
  .hero-times button:active { transform: scale(0.96); }
  .hero-times button[aria-pressed='true'] { background: var(--ink-now); color: var(--zen); box-shadow: none; }
  :root[data-ink='light'] .hero-times button[aria-pressed='true'] { color: #1b1a24; }
  @media (hover: hover) and (pointer: fine) {
    .hero-times button:hover:not([aria-pressed='true']) { box-shadow: inset 0 0 0 1px color-mix(in srgb, currentColor 60%, transparent); }
  }

  .hero-read { position: absolute; top: calc(var(--hd-h) + clamp(20px, 7cqh, 100px)); right: var(--gutter); margin: 0; display: grid; gap: 14px; text-align: right; }
  .hero-read div { display: grid; gap: 3px; }
  .hero-read dt { font: 600 10.5px/1 var(--sans); letter-spacing: 0.2em; text-transform: uppercase; opacity: 0.6; }
  .hero-read dd { margin: 0; font: 500 14px/1.2 var(--sans); font-variant-numeric: tabular-nums; }

  .hero-dock { position: absolute; left: 50%; bottom: calc(clamp(18px, 4cqh, 40px) + env(safe-area-inset-bottom, 0px)); width: min(880px, 100% - 2 * var(--gutter)); transform: translateX(-50%); z-index: 3; }

  @media (max-width: 1100px) { .hero-read { display: none; } }
  @media (max-width: 760px) {
    .hero { min-height: 600px; }
    .hero-h { font-size: min(21cqw, 11.5cqh); max-width: 3.74em; }
    .hh-greet { font-size: 0.31em; }
    .hero-times { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-right: calc(-1 * var(--gutter)); padding-right: var(--gutter); mask-image: linear-gradient(to right, #000 85%, transparent); }
    .hero-times::-webkit-scrollbar { display: none; }
    .hero-times button { flex: none; }
  }
</style>
