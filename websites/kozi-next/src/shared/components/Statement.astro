---
// What Kozi is, in one sentence that lights up word by word as you read down: each word warms
// from a readable grey to its own colour (ink, or amber for the last phrase).
import { LAYOUT } from '@shared/data/kozi';
---
<section class="stm" aria-labelledby="stm-h">
  <div class="wrap stm-in">
    <p class="eyebrow" data-reveal>Kozi @ Vortex KLCC</p>
    <h2 id="stm-h" class="display stm-h" data-words>
      A home in the middle of Kuala Lumpur, with two bedrooms, two bathrooms, a kitchen of your own and <em>the city outside the window.</em>
    </h2>
    <div class="stm-foot">
      <p class="lede" data-reveal>On Jalan Sultan Ismail in the Golden Triangle, between KLCC and Bukit Bintang. Walk to Pavilion KL, the Petronas Twin Towers and the street food of Jalan Alor.</p>
      <ul class="stm-facts" role="list">
        {LAYOUT.map((f, i) => <li data-reveal style={`--d:${i * 70}`}><span>{String(i + 1).padStart(2, '0')}</span>{f}</li>)}
      </ul>
    </div>
  </div>
</section>

<style is:global>
  .stm { background: var(--cream); padding: clamp(96px, 14vw, 200px) 0 clamp(80px, 11vw, 160px); }
  .stm-h { font-size: clamp(34px, 4.9vw, 78px); line-height: 1.04; letter-spacing: -0.026em; margin-top: 28px; max-width: 11.5em; }
  .stm-h .w { color: #8a8077; } /* 3.4:1 on cream, so the sentence reads before it lights up */
  .rm .stm-h .w { color: inherit; }
  .stm-foot { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 120px); margin-top: clamp(48px, 6vw, 88px); align-items: end; }
  .stm-facts { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0 28px; }
  .stm-facts li { display: flex; gap: 14px; align-items: baseline; padding: 16px 0; border-top: 1px solid var(--line); font-weight: 550; font-size: 16px; }
  .stm-facts li span { font: 600 11px/1 var(--sans); letter-spacing: 0.12em; color: var(--amber-deep); }
  @media (max-width: 860px) { .stm-foot { grid-template-columns: 1fr; } }
</style>
