---
// The booking card on a suite page: live nightly prices on the calendar and the total before
// you go on to pay. On a phone a bar at the bottom keeps the price and the next step in reach.
// Only for a suite that can be booked online (its bookType names a booking type in Orbique).
import { POLICIES } from '@shared/data/kozi';
import type { Building, Suite } from '@shared/lib/content';
interface Props { suite: Suite; building: Building }
const { suite, building } = Astro.props;
const pop = `bk-when-${suite.id}`;
const most = suite.sleeps + (suite.extraBed ? 1 : 0);
---
<aside class="bk" data-book={suite.bookType} data-unit={`${building.id}/${suite.id}`} data-most={most} aria-label={`Book the ${suite.name}`}>
  <div class="bk-card" data-bk-card>
    <div class="bk-head">
      <p class="bk-rate"><span class="bk-k" data-bk-k>From</span> <b data-bk-rate>&nbsp;</b> <span class="bk-unit">a night</span></p>
    </div>

    <div class="bk-fields" data-bk-fields>
      <button type="button" class="bk-f" data-bk-open aria-haspopup="dialog" aria-expanded="false" aria-controls={pop}>
        <span class="s-k">Check-in</span><span class="bk-v" data-bk-in>Add date</span>
      </button>
      <button type="button" class="bk-f" data-bk-open aria-haspopup="dialog" aria-expanded="false" aria-controls={pop}>
        <span class="s-k">Check-out</span><span class="bk-v" data-bk-out>Add date</span>
      </button>
      <div class="bk-f bk-who">
        <span><span class="s-k" id={`bk-g-${suite.id}`}>Guests</span><span class="bk-v"><output data-count>2</output> <span data-bk-gword>guests</span></span></span>
        <div class="stepper" role="group" aria-labelledby={`bk-g-${suite.id}`}>
          <button type="button" data-dec aria-label="One guest fewer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 12h12" /></svg></button>
          <button type="button" data-inc aria-label="One more guest"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 12h12M12 6v12" /></svg></button>
        </div>
      </div>
    </div>

    <button type="button" class="btn amber bk-go" data-bk-go><span data-bk-go-label>Check dates</span> <span class="arr" aria-hidden="true">→</span></button>

    <div class="bk-sum" data-bk-sum hidden aria-live="polite">
      <dl>
        <div><dt data-bk-nights></dt><dd data-bk-sub></dd></div>
        <div data-bk-extra hidden><dt data-bk-extra-k>Extra bed</dt><dd data-bk-extra-v></dd></div>
        <div class="bk-total"><dt>Total</dt><dd data-bk-total></dd></div>
      </dl>
      <p class="bk-fine">You'll check everything before you pay.</p>
    </div>
    <p class="bk-msg" data-bk-msg role="status"></p>

    <ul class="bk-notes" role="list">
      <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>{POLICIES.cancel}</li>
      <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 8v5l3 2" /><circle cx="12" cy="12" r="8.5" /></svg>Check in from {building.checkIn}, check out by {building.checkOut}.</li>
      {suite.extraBed && <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10" /></svg>{POLICIES.extraBed}</li>}
    </ul>
    <p class="bk-test" data-bk-test hidden>Test mode: these are sample prices, and no real booking is made yet.</p>
    <div class="s-pop s-pop-when bk-pop" id={pop} data-bk-pop role="dialog" aria-label="Choose your dates" tabindex="-1">
      <div class="s-pop-head"><p class="s-pop-k" data-bk-hint>Pick the day you arrive</p><button type="button" class="s-x" data-bk-close aria-label="Close"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg></button></div>
      <div data-cal></div>
      <div class="s-pop-foot">
        <p data-bk-line aria-live="polite">Prices are per night</p>
        <button type="button" class="s-link" data-bk-clear>Clear</button>
        <button type="button" class="btn small" data-bk-done>Done</button>
      </div>
    </div>
  </div>

  <div class="s-shade" data-bk-shade aria-hidden="true"></div>
  <div class="bk-bar" data-bk-bar>
    <p><b data-bk-bar-rate>&nbsp;</b> <span>a night</span><small data-bk-bar-dates>Add your dates</small></p>
    <button type="button" class="btn amber" data-bk-bar-go><span data-bk-bar-label>Check dates</span></button>
  </div>
</aside>

<style is:global>
  .bk { position: relative; }
  .bk-card { position: sticky; top: calc(var(--hd-h) + 20px); padding: 26px; border-radius: 26px; background: var(--paper); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 30px 70px -40px rgb(0 0 0 / 0.45), 0 0 0 1px var(--line); }
  .bk-head { padding-bottom: 18px; }
  .bk-rate { margin: 0; display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .bk-k { font: 600 13px/1 var(--sans); color: var(--muted); }
  .bk-rate b { font: 800 40px/1 var(--display); font-variation-settings: var(--soft); letter-spacing: -0.02em; font-variant-numeric: lining-nums; min-width: 3ch; }
  .bk-unit { font-size: 15px; color: var(--ink-2); }
  .bk-fields { display: grid; grid-template-columns: 1fr 1fr; border-radius: 18px; box-shadow: inset 0 0 0 1px rgb(238 240 245 / 0.2); }
  .bk-f { display: grid; gap: 5px; align-content: center; min-height: 66px; padding: 12px 16px; text-align: left; border-radius: 18px; transition: background-color 200ms ease, box-shadow 200ms ease; }
  .bk-f + .bk-f { box-shadow: inset 1px 0 0 rgb(238 240 245 / 0.2); border-radius: 0 18px 18px 0; }
  .bk-f:first-child { border-radius: 18px 0 0 18px; }
  .bk-who { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; box-shadow: inset 0 1px 0 rgb(238 240 245 / 0.2); border-radius: 0 0 18px 18px; }
  .bk-who > span { display: grid; gap: 5px; }
  .bk-v { font: 550 15.5px/1.2 var(--sans); white-space: nowrap; }
  .bk-v output { font: inherit; }
  .bk:not(.has-dates) [data-bk-in], .bk:not(.has-dates) [data-bk-out] { color: var(--muted); }
  .bk-f[aria-expanded='true'] { background: rgb(238 240 245 / 0.08); box-shadow: inset 0 0 0 1.5px var(--ink); border-radius: 18px; }
  @media (hover: hover) and (pointer: fine) { button.bk-f:hover:not([aria-expanded='true']) { background: rgb(238 240 245 / 0.04); } }
  .bk-go { width: 100%; height: 56px; margin-top: 14px; font-size: 16px; }
  .bk-go[aria-busy='true'] { opacity: 0.7; pointer-events: none; }
  .bk-sum { margin-top: 18px; transition: opacity 200ms ease; }
  .bk-sum.loading { opacity: 0.45; }
  .bk-sum dl { margin: 0; display: grid; gap: 10px; }
  .bk-sum dl > div { display: flex; justify-content: space-between; gap: 16px; font-size: 15px; }
  .bk-sum dt { color: var(--ink-2); } .bk-sum dd { margin: 0; font-variant-numeric: tabular-nums; }
  .bk-total { padding-top: 12px; margin-top: 2px; border-top: 1px solid var(--line); font-weight: 650; font-size: 16.5px !important; }
  .bk-total dt { color: var(--ink) !important; }
  .bk-fine { margin: 12px 0 0; font-size: 13px; color: var(--muted); text-align: center; }
  .bk-msg { margin: 12px 0 0; font-size: 14px; color: #FF9A7A; }
  .bk-msg:empty { display: none; }
  .bk-notes { list-style: none; margin: 20px 0 0; padding: 18px 0 0; border-top: 1px solid var(--line); display: grid; gap: 10px; font-size: 14px; color: var(--ink-2); }
  .bk-notes li { display: grid; grid-template-columns: 18px 1fr; gap: 10px; align-items: start; }
  .bk-notes svg { width: 18px; height: 18px; margin-top: 2px; fill: none; stroke: var(--amber-deep); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .bk-test { margin: 14px 0 0; padding: 10px 12px; border-radius: 12px; background: rgb(231 165 76 / 0.1); color: var(--amber-deep); font: 600 13px/1.4 var(--sans); text-align: center; }
  /* wide screens: the calendar opens beside the card, two months; narrower: inside the card, one month */
  @media (min-width: 1200px) { .bk-pop { top: 0; right: calc(100% + 16px); left: auto; transform-origin: 100% 150px; } }
  @media (min-width: 761px) and (max-width: 1199px) {
    .bk-pop { top: var(--bk-top, 150px); left: -1px; right: -1px; width: auto; transform-origin: 50% 0; }
  }
  @media (max-width: 900px) { .bk { order: -1; } }
  .bk-bar { display: none; }

  @media (max-width: 760px) {
    .bk-card { position: static; padding: 22px 20px; }
    .bk[data-open] .s-shade { opacity: 1; visibility: visible; transition: opacity 300ms ease; }
    .bk-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 18; display: flex; align-items: center; justify-content: space-between; gap: 14px;
      padding: 12px 16px calc(12px + env(safe-area-inset-bottom, 0px)); background: rgb(11 16 32 / 0.94); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
      box-shadow: 0 -1px 0 var(--line); transform: translateY(100%); transition: transform 320ms var(--ease-drawer); }
    .bk-bar.on { transform: none; }
    .bk-bar p { margin: 0; display: grid; grid-template-columns: auto 1fr; column-gap: 6px; align-items: baseline; }
    .bk-bar b { font: 800 24px/1 var(--display); font-variation-settings: var(--soft); }
    .bk-bar p > span { font-size: 13.5px; color: var(--ink-2); }
    .bk-bar small { grid-column: 1 / -1; margin-top: 4px; font-size: 13px; color: var(--muted); text-decoration: underline; text-underline-offset: 3px; }
    .bk-bar .btn { height: 48px; padding: 0 22px; }
  }
</style>
