---
// A suite's photos: five in a mosaic on a wide screen, a swipeable strip on a phone, and every
// photo full screen in a viewer that works with arrow keys, swipes and the Escape key.
import Photo from './Photo.astro';
import Viewer from './Viewer.astro';
import type { Photo as P } from '@shared/lib/content';
interface Props { photos: P[]; name: string; note?: string }
const { photos, name, note } = Astro.props;
const few = photos.length < 5;
---
<div class:list={['gl', { 'gl-few': few }]} data-gallery>
  <div class="gl-grid">
    {photos.slice(0, few ? 1 : 5).map((p, i) => (
      <button type="button" class:list={['gl-tile', { 'gl-main': i === 0 }]} data-open-at={i} aria-label={`Open photo ${i + 1} of ${photos.length}: ${p.alt}`}>
        <Photo p={p} alt="" eager={i === 0} skip="(max-width: 900px)" sizes={i === 0 ? '(max-width: 900px) 100vw, 50vw' : '25vw'} />
      </button>
    ))}
    {note && <p class="gl-note">{note}</p>}
  </div>
  <div class="gl-strip" data-strip>
    {photos.map((p, i) => (
      <button type="button" class="gl-slide" data-open-at={i} aria-label={`Open photo ${i + 1} of ${photos.length}: ${p.alt}`}>
        <Photo p={p} alt="" eager={i === 0} low={i > 0} skip="(min-width: 901px)" sizes="100vw" />
      </button>
    ))}
  </div>
  {photos.length > 1 && (
    <button type="button" class="gl-all" data-open-at="0">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="7" height="7" rx="1.5" /><rect x="13.5" y="3.5" width="7" height="7" rx="1.5" /><rect x="3.5" y="13.5" width="7" height="7" rx="1.5" /><rect x="13.5" y="13.5" width="7" height="7" rx="1.5" /></svg>
      {/* the name is the words on the button, so voice control can say what it sees (the phone shows the count) */}
      <span class="gl-all-wide">Show all {photos.length} photos</span><span class="gl-all-phone"><b data-strip-n>1</b> / {photos.length}<span class="sr-only"> photos. Show all</span></span>
    </button>
  )}

  <Viewer photos={photos} name={name} />
</div>

<style is:global>
  .gl { position: relative; }
  .gl-grid { display: grid; grid-template-columns: 2fr 1fr 1fr; grid-template-rows: 1fr 1fr; gap: 8px; height: clamp(400px, 60vh, 640px); border-radius: 28px; overflow: hidden; }
  .gl-few .gl-grid { grid-template-columns: 1fr; grid-template-rows: 1fr; }
  .gl-tile { position: relative; overflow: hidden; background: var(--sand); cursor: zoom-in; }
  .gl-main { grid-row: 1 / 3; }
  .gl-tile picture, .gl-tile img { width: 100%; height: 100%; }
  .gl-tile img { object-fit: cover; transition: transform 700ms var(--ease-out), filter 300ms ease; }
  .gl-tile::after { content: ''; position: absolute; inset: 0; background: rgb(20 18 26 / 0); transition: background-color 250ms ease; pointer-events: none; }
  @media (hover: hover) and (pointer: fine) {
    .gl-tile:hover img { transform: scale(1.035); }
    .gl-grid:hover .gl-tile:not(:hover)::after { background: rgb(20 18 26 / 0.12); }
  }
  .gl-all { position: absolute; right: 18px; bottom: 18px; display: inline-flex; align-items: center; gap: 9px; height: 42px; padding: 0 16px; border-radius: 999px;
    background: rgb(11 16 32 / 0.94); color: var(--ink); font: 600 14px/1 var(--sans); box-shadow: 0 10px 30px -12px rgb(20 18 26 / 0.45);
    transition: transform 160ms var(--ease-out), background-color 200ms ease; }
  .gl-all svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.6; }
  .gl-all:active { transform: scale(0.97); }
  @media (hover: hover) and (pointer: fine) { .gl-all:hover { background: rgb(238 240 245 / 0.08); } }
  .gl-all-phone { display: none; font-variant-numeric: tabular-nums; }
  .gl-strip { display: none; }

  @media (max-width: 900px) {
    .gl-grid { display: none; }
    .gl-strip { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin-inline: calc(var(--gutter) * -1); overscroll-behavior-x: contain; }
    .gl-strip::-webkit-scrollbar { display: none; }
    .gl-slide { flex: 0 0 100%; scroll-snap-align: center; scroll-snap-stop: always; aspect-ratio: 4 / 3.2; background: var(--sand); }
    .gl-slide picture, .gl-slide img { width: 100%; height: 100%; }
    .gl-slide img { object-fit: cover; }
    .gl-all { right: 12px; bottom: 12px; height: 34px; padding: 0 12px; font-size: 13px; background: rgb(20 18 26 / 0.62); color: var(--cream); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); box-shadow: none; }
    .gl-all svg { display: none; }
    .gl-all-wide { display: none; }
    .gl-all-phone { display: inline; }
    .gl-note { left: 12px; bottom: 12px; font-size: 12px; padding: 8px 12px; }
  }

</style>
