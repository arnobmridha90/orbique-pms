---
// "A day at Kozi": scroll and the sky over the skyline runs from first light to late night,
// with a few true things to do at each hour.
import { buildSkyline } from '@shared/lib/skyline';
import Photo from './Photo.astro';

const sky = buildSkyline(11, { id: 'day' });
const stops = [
  { k: 'First light', t: 'Coffee by the window while the city wakes up.', photo: 'boutique/09-coffee-tea' },
  { k: 'Morning', t: 'KLCC Park and the Twin Towers, before the heat of the day.', photo: 'premium-b/10-klcc-window-view' },
  { k: 'Afternoon', t: 'Pavilion KL for shopping and lunch in the cool, when the afternoon rain rolls in.', photo: 'premium-a/03-dining-living-daylight' },
  { k: 'Golden hour', t: 'Back to the suite as the sun goes down over the city.', photo: 'boutique/10-klcc-night-view' },
  { k: 'Night', t: 'Street food on Jalan Alor, then the towers lit up all the way home.', photo: 'premium-b/03-tv-klcc-night' },
];
---
<section class="dy" data-day aria-labelledby="dy-h">
  <div class="dy-pin">
    <div class="dy-sky" aria-hidden="true"><canvas data-day-sky></canvas></div>
    <div class="dy-city" aria-hidden="true"><div class="city-box dy-box"><Fragment set:html={sky.svg} /></div></div>
    <div class="dy-ground" aria-hidden="true"></div>
    <div class="wrap dy-copy">
      <p class="eyebrow dy-eyebrow">A day at Kozi</p>
      <h2 id="dy-h" class="display dy-h"><span data-day-clock>7:00 am</span></h2>
      <ol class="dy-stops" role="list">
        {stops.map((s, i) => (
          <li class="dy-stop" style={`--i:${i}`}>
            <p class="dy-k">{s.k}</p>
            <p class="dy-t">{s.t}</p>
          </li>
        ))}
      </ol>
    </div>
    <div class="dy-shots" aria-hidden="true">
      {stops.map((s) => <figure class="dy-shot"><Photo k={s.photo} alt="" sizes="(max-width: 760px) 46vw, 22vw" /></figure>)}
    </div>
    <div class="dy-bar" aria-hidden="true"><span data-day-bar></span></div>
  </div>
</section>

<style is:global>
  .dy { position: relative; height: 520vh; background: #0b0e1c; }
  .rm .dy, html:not(.js) .dy { height: auto; }
  .dy-pin { position: sticky; top: 0; height: 100svh; overflow: hidden; container-type: size; isolation: isolate; color: var(--ink-now, var(--ink));
    --ink-now: var(--ink); background: linear-gradient(to top, var(--hor) 30%, var(--zen)); }
  .dy[data-ink='light'] .dy-pin { --ink-now: var(--cream); }
  .dy-sky, .dy-sky canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .dy-sky { z-index: -2; }
  .dy-city { position: absolute; inset: 0; z-index: -1; }
  .dy-box { --W: max(100cqw, 150cqh); bottom: -2cqh; left: clamp(100cqw - var(--W), 50cqw - 0.5 * var(--W), 0px); }
  .dy-ground { position: absolute; inset: auto 0 0; height: 30%; z-index: -1; background: linear-gradient(to top, color-mix(in srgb, var(--sk4) 94%, transparent), transparent); }
  .dy-copy { position: relative; padding-top: calc(var(--hd-h) + 6cqh); }
  .dy-eyebrow { color: inherit; opacity: 0.8; }
  .dy-h { font-size: min(13cqw, 18cqh, 200px); line-height: 0.92; letter-spacing: -0.035em; margin-top: 18px; font-variant-numeric: tabular-nums; }
  .dy-stops { list-style: none; margin: 4cqh 0 0; padding: 0; position: relative; max-width: 17.25em; min-height: 9em; }
  .dy-stop { position: absolute; inset: 0 auto auto 0; opacity: 0; transform: translateY(14px); transition: opacity 450ms ease, transform 650ms var(--ease-out); }
  .dy-stop.on { opacity: 1; transform: none; }
  .dy-k { margin: 0 0 8px; font: 600 12px/1 var(--sans); letter-spacing: 0.2em; text-transform: uppercase; }
  .dy-t { margin: 0; font: 400 clamp(20px, 1.9vw, 28px)/1.3 var(--display); font-variation-settings: var(--soft); letter-spacing: -0.01em; }
  .dy-shots { position: absolute; right: var(--gutter); top: calc(var(--hd-h) + 6cqh); width: min(26cqw, 360px); aspect-ratio: 4 / 5; }
  .dy-shot { position: absolute; inset: 0; margin: 0; border-radius: 20px; overflow: hidden; box-shadow: 0 30px 70px -30px rgb(0 0 0 / 0.6);
    clip-path: inset(100% 0 0 0 round 20px); transition: clip-path 800ms var(--ease-in-out); }
  .dy-shot.on { clip-path: inset(0 0 0 0 round 20px); }
  .dy-shot img { width: 100%; height: 100%; object-fit: cover; }
  .dy-bar { position: absolute; left: var(--gutter); right: var(--gutter); bottom: calc(22px + env(safe-area-inset-bottom, 0px)); height: 2px; background: rgb(246 239 228 / 0.18); border-radius: 2px; overflow: hidden; }
  .dy-bar span { display: block; height: 100%; width: 100%; background: var(--amber-hi); transform-origin: left; transform: scaleX(0); }
  .rm .dy-pin, html:not(.js) .dy-pin { position: relative; }
  .rm .dy-stop, html:not(.js) .dy-stop { position: static; opacity: 1; transform: none; margin-bottom: 18px; }
  .rm .dy-stops, html:not(.js) .dy-stops { min-height: 0; }
  @media (max-width: 760px) {
    .dy-shots { width: 40cqw; top: auto; bottom: 64px; right: var(--gutter); }
    .dy-h { font-size: min(19cqw, 14cqh); }
    .dy-stops { max-width: 12.65em; }
  }
</style>
