---
// Book direct: members see the lower direct price. Free, email only, no password.
import Logo from './Logo.astro';
import { POLICIES } from '@shared/data/kozi';
const perks = [
  { t: 'The member price on every night', d: 'Lower than the booking sites, because there is no booking-site commission.' },
  { t: 'Free cancellation', d: POLICIES.cancel },
  { t: 'Pay by card, securely', d: 'Card payments go through Stripe. We never see your card number.' },
  { t: 'Talk to the team', d: 'Message us before and during your stay, in English, Bahasa Malaysia or Bahasa Indonesia.' },
];
---
<section class="dr" id="direct" aria-labelledby="dr-h">
  <div class="wrap dr-in">
    <div class="dr-copy">
      <p class="eyebrow eyebrow-light" data-reveal>Book direct</p>
      <h2 id="dr-h" class="display h2" data-split>Members pay <em>less.</em></h2>
      <p class="lede" data-reveal>Join Kozi for free with just your email. No password and no forms: we send you a code, and member prices show on every stay.</p>
      <ul class="dr-perks" role="list">
        {perks.map((p, i) => <li data-reveal style={`--d:${i * 70}`}><b>{p.t}</b><span>{p.d}</span></li>)}
      </ul>
      <div class="dr-cta" data-reveal>
        <button type="button" class="btn amber" data-member-open data-member-out>Join free <span class="arr" aria-hidden="true">→</span></button>
        <a class="btn ghost" href="/stays/" data-member-in hidden>See member prices <span class="arr" aria-hidden="true">→</span></a>
        <p class="dr-note" data-member-note>Already a member? <button type="button" data-member-open>Sign in</button></p>
      </div>
    </div>
    <div class="dr-stage" data-reveal>
      <div class="dr-card" data-tilt>
        <div class="dr-sheen" aria-hidden="true"></div>
        <div class="dr-card-top"><Logo id="card" class="dr-logo" /><span class="dr-chip">Member</span></div>
        <svg class="dr-sun" viewBox="0 0 200 100" aria-hidden="true"><defs><linearGradient id="drs" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#f0b860" /><stop offset="1" stop-color="#c8862e" /></linearGradient></defs><path d="M10 100a90 90 0 0 1 180 0Z" fill="url(#drs)" opacity=".9" /><rect x="0" y="94" width="200" height="6" fill="#14121a" /></svg>
        <div class="dr-card-foot"><span data-member-name>Your name here</span><span>Kozi direct</span></div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .dr { background: radial-gradient(120% 90% at 85% 10%, #2a2338 0%, var(--night) 55%); color: var(--cream); padding: clamp(96px, 12vw, 180px) 0; overflow: hidden; }
  .dr .display em { color: var(--amber-hi); }
  .dr .lede { color: rgb(246 239 228 / 0.74); }
  .dr-in { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(40px, 6vw, 110px); align-items: center; }
  .dr-copy .h2 { margin: 22px 0; }
  .dr-perks { list-style: none; padding: 0; margin: 36px 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 26px 32px; }
  .dr-perks li { display: grid; gap: 6px; padding-top: 18px; border-top: 1px solid rgb(246 239 228 / 0.14); }
  .dr-perks b { font-weight: 600; }
  .dr-perks span { font-size: 15px; color: rgb(246 239 228 / 0.66); }
  .dr-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 22px; margin-top: 40px; }
  .dr-cta [hidden] { display: none; }
  .dr-note { margin: 0; font-size: 14.5px; color: rgb(246 239 228 / 0.66); }
  .dr-note button { color: var(--cream); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .dr .btn.ghost { color: var(--cream); }
  .dr-stage { perspective: 1200px; display: grid; place-items: center; }
  .dr-card { position: relative; width: min(100%, 460px); aspect-ratio: 1.586; border-radius: 26px; padding: 26px; display: flex; flex-direction: column; justify-content: space-between; overflow: hidden;
    background: linear-gradient(150deg, #262033 0%, #14121a 60%, #0d0c12 100%); box-shadow: 0 50px 90px -40px rgb(0 0 0 / 0.9), inset 0 0 0 1px rgb(255 255 255 / 0.09);
    transform: rotateX(var(--rx, 8deg)) rotateY(var(--ry, -14deg)); transform-style: preserve-3d; will-change: transform; }
  .dr-sheen { position: absolute; inset: -40%; background: radial-gradient(40% 40% at var(--sx, 30%) var(--sy, 30%), rgb(240 184 96 / 0.22), transparent 60%); pointer-events: none; }
  .dr-card-top { position: relative; display: flex; justify-content: space-between; align-items: flex-start; }
  .dr-logo { width: 74px; color: var(--cream); }
  .dr-chip { font: 600 11px/1 var(--sans); letter-spacing: 0.24em; text-transform: uppercase; color: var(--amber-hi); padding: 8px 12px; border-radius: 999px; box-shadow: inset 0 0 0 1px rgb(240 184 96 / 0.4); }
  .dr-sun { position: absolute; left: 50%; bottom: 18%; width: 46%; transform: translateX(-50%); opacity: 0.9; }
  .dr-card-foot { position: relative; display: flex; justify-content: space-between; font: 600 13px/1 var(--sans); letter-spacing: 0.14em; text-transform: uppercase; color: rgb(246 239 228 / 0.8); }
  @media (max-width: 900px) { .dr-in { grid-template-columns: 1fr; } .dr-stage { order: -1; } .dr-card { width: min(100%, 380px); } }
  @media (max-width: 560px) { .dr-perks { grid-template-columns: 1fr; } }
</style>
