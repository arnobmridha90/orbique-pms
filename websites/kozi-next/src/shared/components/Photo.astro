---
// A responsive photo: a content photo (p), bundled or uploaded in Orbique, or a bundled one by its key (k).
// The files are JPEGs at the widths the photo was stored at (see photoUrl in lib/content.ts), and the browser picks one.
// alt: overrides the photo's own alt text ('' for a photo that only decorates, or that a label already describes).
// skip: a media query where the photo is hidden (a phone's strip on a wide screen, say). There a blank stands in,
// so the browser doesn't fetch a photo nobody sees, which would slow the one that's showing.
// low: fetched at low priority, for a photo just out of sight that mustn't hold up the one in view
import { builtin, midWidth, photoUrl, srcset, type Photo } from '@shared/lib/content';
interface Props { p?: Photo; k?: string; alt?: string; sizes?: string; class?: string; eager?: boolean; low?: boolean; skip?: string }
const { k, alt, sizes = '(max-width: 760px) 100vw, 50vw', class: cls, eager = false, low = false, skip } = Astro.props;
const p = Astro.props.p ?? builtin(k!);
const BLANK = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
---
<picture>
  {skip && <source media={skip} srcset={BLANK} />}
  <img src={photoUrl(p, midWidth(p))} srcset={srcset(p)} alt={alt ?? p.alt} sizes={sizes} class={cls} loading={eager ? 'eager' : 'lazy'} decoding="async"
    fetchpriority={eager ? 'high' : low ? 'low' : undefined} width={p.w} height={p.h} />
</picture>
