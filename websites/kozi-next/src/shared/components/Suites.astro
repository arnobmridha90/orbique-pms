---
// The suites, in the content's order. Each card shows two photos (the second fades in on hover),
// the floor, what you can see and what makes it different.
import { VIEWS } from '@shared/data/kozi';
import { cover, suitePath, type Building, type Suite } from '@shared/lib/content';
import { numberWord } from '@shared/lib/words';
import Photo from './Photo.astro';
// building: the building whose page this is (on the home page, the only building, if there is just one)
interface Props { list: { s: Suite; b: Building }[]; building?: Building }
const { list, building } = Astro.props;
const n = list.length;
const at = building ? ` at ${building.name.replace(/^Kozi @ /, '').replace(/ KLCC$/, '')}.` : '.';
const same = list.every(({ s }) => s.bedrooms === 2 && s.bathrooms === 2 && s.sleeps === 4);
const sizes = '(max-width: 760px) 86vw, (max-width: 1100px) 46vw, 31vw';
---
{n > 0 && (
<section class="st" id="suites" aria-labelledby="st-h">
  <div class="wrap">
    <div class="st-head">
      <div>
        <p class="eyebrow" data-reveal>The suites</p>
        <h2 id="st-h" class="display h2" data-split>{n === 1 ? 'One way' : `${numberWord(n)} ways`} to stay <em>{at.slice(1) || 'with us.'}</em></h2>
      </div>
      <p class="lede" data-reveal>{same
        ? 'Every suite has two bedrooms, two bathrooms, a full kitchen and room for four. The difference is the finish, the floor and the view.'
        : 'Each suite has its own page, with its rooms, its photos and its live price.'}</p>
    </div>
    <ul class="st-list" role="list">
      {list.map(({ s, b }, i) => {
        const p0 = cover(s, b), p1 = s.photos[1];
        return (
          <li class="st-card" data-reveal style={`--d:${i * 90}`}>
            <a href={suitePath(b, s)} class="st-link" aria-label={[s.name, s.levels].filter(Boolean).join(', ')}>
              <div class="st-media">
                {p0 && <Photo p={p0} sizes={sizes} class="st-a" />}
                {p1 && <Photo p={p1} alt="" sizes={sizes} class="st-b" skip="not all and (hover: hover) and (pointer: fine)" />}
                {s.levels && <span class="st-level">{s.levels}</span>}
                {!s.photos.length && <span class="st-note">Suite photos are on the way</span>}
              </div>
              <div class="st-body">
                <h3 class="display st-name">{s.name}</h3>
                <p class="st-line">{s.line}</p>
                <p class="st-tags">
                  {s.views.map((v) => <span class="st-tag">{VIEWS[v].short} view</span>)}
                  {s.highlights.filter((h) => !/view/i.test(h)).slice(0, 2).map((h) => <span class="st-tag">{h}</span>)}
                </p>
                <span class="st-cta">See the suite <span aria-hidden="true">→</span></span>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>
)}

<style is:global>
  .st { background: var(--paper); padding: clamp(96px, 12vw, 180px) 0; }
  .st-head { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(28px, 5vw, 90px); align-items: end; margin-bottom: clamp(44px, 6vw, 80px); }
  .st-head .h2 { margin-top: 22px; }
  .st-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(16px, 2vw, 28px); }
  .st-link { display: block; height: 100%; }
  .st-media { position: relative; aspect-ratio: 4 / 5; border-radius: var(--radius); overflow: hidden; background: var(--sand); }
  .st-media picture, .st-media img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .st-media img { object-fit: cover; transition: transform 1200ms var(--ease-out), opacity 600ms ease; }
  .st-b, .st-b img { opacity: 0; }
  .st-level { position: absolute; left: 14px; top: 14px; padding: 8px 12px; border-radius: 999px; font: 600 12px/1 var(--sans); letter-spacing: 0.04em;
    background: rgb(251 247 240 / 0.86); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  .st-note { position: absolute; left: 14px; right: 14px; bottom: 14px; padding: 10px 14px; border-radius: 14px; font-size: 13px; color: var(--cream); background: rgb(20 18 26 / 0.55); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  .st-body { padding: 22px 4px 0; display: grid; gap: 10px; }
  .st-name { font-size: clamp(28px, 2.6vw, 38px); }
  .st-line { margin: 0; color: var(--ink-2); max-width: 19.55em; }
  .st-tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 4px 0 0; }
  .st-tag { padding: 7px 11px; border-radius: 999px; font: 550 12.5px/1 var(--sans); box-shadow: inset 0 0 0 1px var(--line); }
  .st-cta { margin-top: 8px; font-weight: 600; font-size: 15px; display: inline-flex; gap: 8px; align-items: center; }
  .st-cta span { transition: transform 200ms var(--ease-out); }
  .st-link:active .st-media { transform: scale(0.99); }
  .st-media { transition: transform 160ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .st-link:hover .st-a img { transform: scale(1.04); }
    .st-link:hover .st-b, .st-link:hover .st-b img { opacity: 1; }
    .st-link:hover .st-b img { transform: scale(1.04); }
    .st-link:hover .st-cta span { transform: translateX(4px); }
  }
  @media (max-width: 1100px) { .st-list { grid-template-columns: repeat(2, 1fr); } .st-head { grid-template-columns: 1fr; } }
  @media (max-width: 760px) {
    .st-list { grid-auto-flow: column; grid-template-columns: none; grid-auto-columns: 84%; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
      margin: 0 calc(-1 * var(--gutter)); padding: 0 var(--gutter); scroll-padding: 0 var(--gutter); }
    .st-list::-webkit-scrollbar { display: none; }
    .st-card { scroll-snap-align: start; }
  }
</style>
