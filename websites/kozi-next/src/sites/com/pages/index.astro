---
// staykozi.com: Kozi everywhere. The Earth lit as it is right now with our cities on it, the
// country chooser (each country has its own site), what a Kozi stay is, and the way to book.
import Layout from '@shared/components/Layout.astro';
import Photo from '@shared/components/Photo.astro';
import StayBand from '@shared/components/StayBand.astro';
import Globe from '@shared/components/Globe.astro';
import { BRAND, COUNTRIES, DESTINATIONS } from '@shared/data/kozi';
import { orgLd } from '@shared/lib/seo';
import { buildSkyline } from '@shared/lib/skyline';

const countries = COUNTRIES.map((c) => ({ ...c, cities: DESTINATIONS.filter((d) => d.countryId === c.id) }));
const sky = buildSkyline(4, { id: 'cc' });
const way = [
  { k: 'premium-a/03-dining-living-daylight', alt: 'The dining table and living room of a Premium Suite in daylight', t: 'Whole homes, not hotel rooms',
    d: 'Two bedrooms, two bathrooms and a full kitchen, so a family or a group of friends has room to live, cook and spread out.' },
  { k: 'boutique/10-klcc-night-view', alt: 'A Petronas tower lit up at dusk, seen from the Boutique Suite', t: 'The view is part of the stay',
    d: 'We choose apartments for what you see from the window. In Kuala Lumpur that is the Petronas Twin Towers, KL Tower or Merdeka 118, depending on the suite.' },
  { k: 'boutique/09-coffee-tea', alt: 'A coffee and tea tray with a kettle, ready for arrival', t: 'Ready when you arrive',
    d: 'Coffee, tea and a kettle in the kitchen, fresh linen on the beds and a washing machine in every suite.' },
  { k: 'premium-b/08-master-bed-front', alt: 'A made bed with white linen in a Premium Suite', t: 'A team that answers',
    d: 'Email us before and during your stay, and a real person replies.' },
  { k: 'boutique/05-bedroom-window-view', alt: 'The city through the bedroom window of a Boutique Suite', t: 'Book with us directly',
    d: 'Book on our own site: you see the price for your dates before you pay, and card payments go through Stripe.' },
];
const website = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Kozi', url: `${BRAND.com}/`, publisher: { '@id': orgLd['@id'] } };
---
<Layout site="com" title="Kozi | Exceptional spaces. Memorable stays." over ink="light"
  description="Kozi stays are whole apartments in the heart of the city, with two bedrooms, a full kitchen and a view. Choose your country, starting with Kozi Malaysia in Kuala Lumpur."
  jsonld={[orgLd, website]}
  alternates={[{ lang: 'x-default', href: `${BRAND.com}/` }, { lang: 'en', href: `${BRAND.com}/` }, { lang: 'en-MY', href: `${BRAND.my}/` }]}>
  <section class="gh stars" data-globe aria-labelledby="gh-h">
    <Globe />
    <div class="wrap gh-copy">
      <p class="gh-live"><span class="live-dot" aria-hidden="true"></span>Live: day and night on Earth, right now</p>
      <h1 id="gh-h" class="display gh-h">Exceptional spaces. <em>Memorable stays.</em></h1>
      <p class="gh-lede">Kozi stays are whole apartments in the heart of the city, with real bedrooms, a full kitchen and a view, looked after by a team that answers. Kuala Lumpur is where we started.</p>
      <div class="gh-choose">
        <p class="gh-k">Choose a country</p>
        <ul class="gh-list" role="list">
          {countries.map((c) => (
            <li>
              <a class="gh-c" href={`${c.site}/`} data-fly={`${c.cities[0].geo.lon},${c.cities[0].geo.lat}`}>
                <span class="gh-c-t"><b>{c.name}</b><small>{c.cities.map((x) => x.city).join(' · ')}</small></span>
                <span class="gh-c-go" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <p class="gh-hint" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 12h8M5 9l-3 3 3 3M19 9l3 3-3 3" /></svg>Drag to turn the Earth</p>
  </section>

  <section class="wrap cc-sec" id="destinations" aria-labelledby="cc-h">
    <div class="cc-head">
      <div>
        <p class="eyebrow" data-reveal>Destinations</p>
        <h2 id="cc-h" class="display h2" data-split>Choose your <em>country.</em></h2>
      </div>
      <p class="lede" data-reveal>Each Kozi country has its own site, with local prices, languages and guides. Kuala Lumpur, in Malaysia, is our first city.</p>
    </div>
    <ul class="cc-list" role="list">
      {countries.map((c) => {
        const city = c.cities[0];
        return (
          <li data-reveal>
            <a class="cc" href={`${c.site}/`} data-country data-city={city.city} data-lat={city.geo.lat} data-lon={city.geo.lon} data-tz={city.tz} data-utc="480">
              <div class="cc-sky" aria-hidden="true">
                <div class="city-box cc-box"><Fragment set:html={sky.svg} /></div>
                <p class="cc-chip"><span class="live-dot"></span><span><span data-cc-time>&nbsp;</span> in {city.city}</span></p>
              </div>
              <div class="cc-body">
                <p class="cc-k">Kozi {c.name} · {c.domain}</p>
                <h3 class="display cc-name">{c.name}</h3>
                <dl class="cc-facts">
                  <div><dt>Cities</dt><dd>{c.cities.map((x) => x.city).join(', ')}</dd></div>
                  <div><dt>Where to stay</dt><dd>{c.cities.flatMap((x) => x.buildings.map((b) => b.name)).join(', ')}</dd></div>
                  <div><dt>We speak</dt><dd>{c.languages.join(', ')}</dd></div>
                  <div><dt>Prices in</dt><dd>{c.currency}</dd></div>
                </dl>
                <span class="btn cc-go">Visit Kozi {c.name} <span class="arr" aria-hidden="true">→</span></span>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  <section class="wy" id="way" data-way aria-labelledby="wy-h">
    <div class="wrap wy-in">
      <div class="wy-media" aria-hidden="true">
        {way.map((w, i) => (
          <figure data-way-shot class:list={{ on: i === 0 }}><Photo k={w.k} alt="" sizes="(max-width: 900px) 92vw, 44vw" /></figure>
        ))}
      </div>
      <div class="wy-copy">
        <p class="eyebrow" data-reveal>The Kozi way</p>
        <h2 id="wy-h" class="display h2" data-split>Stay like you <em>live here.</em></h2>
        <ol class="wy-list" role="list">
          {way.map((w, i) => (
            <li class="wy-item" data-way-item>
              <span class="wy-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="display wy-t">{w.t}</h3>
              <p class="wy-d">{w.d}</p>
              <figure class="wy-phone"><Photo k={w.k} alt={w.alt} sizes="92vw" /></figure>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <StayBand base={BRAND.my} eyebrow="Kozi Malaysia" />
</Layout>

<style is:global>
  /* the hero: deep space with a few stars, and the Earth on the right */
  .gh { position: relative; isolation: isolate; overflow: hidden; color: var(--cream); min-height: max(660px, 100svh); display: grid; align-items: center;
    background: radial-gradient(90% 70% at 72% 46%, #1c2142 0%, #0e1024 52%, #07080f 100%); }
  .gh .gh-stage { position: absolute; top: 50%; right: max(-14vw, -200px); width: min(66vw, 118svh, 1100px); transform: translateY(-50%); }
  .gh-copy { position: relative; z-index: 1; padding: calc(var(--hd-h) + 40px) 0 90px; pointer-events: none; }
  .gh-copy a { pointer-events: auto; }
  .gh-live { display: flex; align-items: center; gap: 10px; margin: 0; font: 600 11.5px/1 var(--sans); letter-spacing: 0.16em; text-transform: uppercase; color: rgb(246 239 228 / 0.72); }
  .gh-h { margin: 26px 0 0; font-size: clamp(52px, 7.4vw, 124px); max-width: 5.46em; }
  .gh-h em { color: var(--amber-hi); }
  .gh-lede { margin: 26px 0 0; max-width: 26.45em; font-size: clamp(17px, 1.3vw, 20px); color: rgb(246 239 228 / 0.8); }
  .gh-choose { margin-top: clamp(32px, 5svh, 52px); max-width: 420px; }
  .gh-k { margin: 0 0 12px; font: 650 10.5px/1 var(--sans); letter-spacing: 0.2em; text-transform: uppercase; color: rgb(246 239 228 / 0.55); }
  .gh-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .gh-c { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px 20px; border-radius: 18px;
    background: rgb(246 239 228 / 0.08); box-shadow: inset 0 0 0 1px rgb(246 239 228 / 0.16); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    transition: background-color 200ms ease, transform 160ms var(--ease-out); }
  .gh-c:active { transform: scale(0.98); }
  .gh-c-t { display: grid; gap: 3px; }
  .gh-c b { font: 400 26px/1.05 var(--display); font-variation-settings: var(--soft); letter-spacing: -0.01em; }
  .gh-c small { font-size: 13.5px; color: rgb(246 239 228 / 0.7); }
  .gh-c-go { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--amber); color: #1d1406; font-weight: 700; transition: transform 200ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .gh-c:hover { background: rgb(246 239 228 / 0.14); }
    .gh-c:hover .gh-c-go { transform: translateX(3px); }
  }
  .gh-hint { position: absolute; right: var(--gutter); bottom: 26px; margin: 0; display: flex; align-items: center; gap: 8px; font: 600 11px/1 var(--sans); letter-spacing: 0.14em; text-transform: uppercase; color: rgb(246 239 228 / 0.5); }
  .gh-hint svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  /* the copy settles in once, as the page opens */
  .js .gh-copy > * { animation: gh-in 1000ms var(--ease-out) backwards; }
  .js .gh-copy > :nth-child(2) { animation-delay: 80ms; } .js .gh-copy > :nth-child(3) { animation-delay: 160ms; } .js .gh-copy > :nth-child(4) { animation-delay: 240ms; }
  @keyframes gh-in { from { opacity: 0; transform: translateY(18px); } }

  .cc-sec { padding: clamp(100px, 12vw, 180px) 0 clamp(90px, 11vw, 160px); }
  .cc-head { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(28px, 5vw, 90px); align-items: end; margin-bottom: clamp(44px, 6vw, 80px); }
  .cc-head .h2 { margin-top: 22px; }
  .cc-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 24px; }
  .cc { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); border-radius: 30px; overflow: hidden; background: var(--paper); box-shadow: inset 0 0 0 1px var(--line);
    transition: transform 160ms var(--ease-out), box-shadow 300ms ease; }
  .cc:active { transform: scale(0.995); }
  .cc-sky { position: relative; min-height: 440px; overflow: hidden; container-type: size; background: linear-gradient(to top, var(--hor) 26%, var(--zen)); }
  .cc-box { --W: max(100cqw, 190cqh); bottom: calc(var(--W) * -0.07); }
  .cc-chip { position: absolute; left: 18px; top: 18px; margin: 0; display: inline-flex; align-items: center; gap: 9px; padding: 9px 13px; border-radius: 999px; font: 600 12.5px/1 var(--sans);
    color: var(--cream); background: rgb(20 18 26 / 0.45); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  .cc-body { padding: clamp(28px, 3.4vw, 52px); display: grid; align-content: center; gap: 16px; }
  .cc-k { margin: 0; font: 650 11px/1.4 var(--sans); letter-spacing: 0.16em; text-transform: uppercase; color: var(--amber-deep); }
  .cc-name { font-size: clamp(44px, 4.6vw, 72px); }
  .cc-facts { margin: 6px 0 0; display: grid; }
  .cc-facts div { display: grid; grid-template-columns: 130px 1fr; gap: 14px; padding: 11px 0; border-top: 1px solid var(--line); font-size: 15px; }
  .cc-facts dt { color: var(--muted); }
  .cc-facts dd { margin: 0; font-weight: 600; }
  .cc-go { justify-self: start; margin-top: 8px; }
  @media (hover: hover) and (pointer: fine) {
    .cc:hover { box-shadow: inset 0 0 0 1px rgb(43 38 34 / 0.2), 0 40px 80px -50px rgb(43 38 34 / 0.55); }
    .cc:hover .cc-go { background: var(--ink-2); }
    .cc:hover .cc-go .arr { transform: translateX(3px); }
  }

  .wy { background: var(--paper); border-top: 1px solid var(--line); padding: clamp(100px, 12vw, 180px) 0; }
  .wy-in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(40px, 7vw, 120px); align-items: start; }
  .wy-media { position: sticky; top: calc(var(--hd-h) + 40px); height: min(calc(100svh - var(--hd-h) - 80px), 760px); border-radius: 28px; overflow: hidden; background: var(--sand); }
  .wy-media figure { position: absolute; inset: 0; margin: 0; opacity: 0; transform: scale(1.05); transition: opacity 700ms ease, transform 1400ms var(--ease-out); }
  .wy-media figure.on { opacity: 1; transform: none; }
  .wy-media picture, .wy-media img { width: 100%; height: 100%; }
  .wy-media img { object-fit: cover; }
  .wy-copy .h2 { margin-top: 22px; }
  .wy-list { list-style: none; margin: clamp(40px, 6vw, 80px) 0 0; padding: 0; }
  .wy-item { position: relative; display: grid; align-content: center; gap: 12px; min-height: 52svh; padding: 36px 0 36px 64px; border-top: 1px solid var(--line); }
  .wy-n { position: absolute; left: 0; top: 50%; transform: translateY(-50%); font: 400 28px/1 var(--display); font-variation-settings: var(--soft); color: var(--muted); transition: color 300ms ease; }
  .wy-item.on .wy-n { color: var(--amber-deep); }
  .wy-t { font-size: clamp(30px, 2.8vw, 44px); line-height: 1.04; }
  .wy-d { margin: 0; max-width: 25.3em; color: var(--ink-2); font-size: 17.5px; }
  .wy-phone { display: none; }

  @media (max-width: 980px) {
    .cc-head { grid-template-columns: 1fr; }
    .cc { grid-template-columns: 1fr; }
    .cc-sky { min-height: 0; aspect-ratio: 16 / 10; }
  }
  @media (max-width: 860px) {
    .gh { display: block; min-height: 0; }
    .gh-copy { padding: calc(var(--hd-h) + 28px) 0 0; }
    .gh .gh-stage { position: relative; top: auto; right: auto; width: calc(100% + 30vw); margin: -6vw -15vw -22vw; transform: none; }
    .gh-hint { display: none; }
    .wy-in { grid-template-columns: 1fr; }
    .wy-media { display: none; }
    .wy-item { min-height: 0; padding: 30px 0 30px 52px; }
    .wy-n { top: 36px; transform: none; font-size: 24px; color: var(--amber-deep); }
    .wy-phone { display: block; margin: 12px 0 0; border-radius: 20px; overflow: hidden; aspect-ratio: 4 / 3; background: var(--sand); }
    .wy-phone picture, .wy-phone img { width: 100%; height: 100%; }
    .wy-phone img { object-fit: cover; }
  }
  @media (max-width: 560px) { .cc-facts div { grid-template-columns: 1fr; gap: 2px; } }
  @media (prefers-reduced-motion: reduce) {
    .js .gh-copy > * { animation: gh-fade 400ms ease backwards; }
    @keyframes gh-fade { from { opacity: 0; } }
    .wy-media figure { transform: none; transition: opacity 400ms ease; }
  }
</style>
