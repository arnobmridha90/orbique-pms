---
// Every page of staykozi.my: the head (title, description, canonical, Open Graph, JSON-LD), the 3D city behind the
// page (kept across page changes by the ClientRouter, with a still image until it is ready and wherever it can't
// run), the header, the page and the footer. The page says where the city's camera goes (cam), whether the
// landmark labels show (pins), which of our floors glow (hi), whether the city is dimmed behind it (dim) and whether
// the city takes drags and taps in the page's empty space (touch).
import '@shared/styles/base.css';
import '@shared/styles/ui.css';
import '@my/styles/night.css';
import { ClientRouter } from 'astro:transitions';
import Top from './Top.astro';
import Foot from './Foot.astro';
import AnimLogo from './AnimLogo.astro';
import { BRAND, PROPERTY } from '@shared/data/kozi';
import display from '@fontsource-variable/big-shoulders-display/files/big-shoulders-display-latin-wght-normal.woff2?url';
import sans from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  image?: string;
  jsonld?: Record<string, unknown>[];
  alternates?: { lang: string; href: string }[];
  noindex?: boolean;
  cam?: string;                      // a camera preset in scripts/city.ts, or 'none' for a page without the city
  pins?: 'on' | 'off' | 'views';
  hi?: number[];                     // our floors to light on the tower
  dim?: boolean;
  touch?: boolean;
  intro?: boolean;                   // the logo intro (home, once per visit)
}
const { title, description, image = '/og-my.jpg', jsonld = [], alternates = [], cam = 'aerial', pins = 'off', hi, dim = false, touch = false, intro = false } = Astro.props;
// a preview build keeps every page out of search
const noindex = Astro.props.noindex || import.meta.env.PUBLIC_NOINDEX === '1';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL(image, `${BRAND.my}/`).href;
const fonts = `@font-face{font-family:'Big Shoulders Display Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${display}) format('woff2-variations');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`
  + `@font-face{font-family:'DM Sans Variable';font-style:normal;font-display:swap;font-weight:100 1000;src:url(${sans}) format('woff2-variations');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`;
const pinList = [
  { id: 'vortex', label: PROPERTY.name, href: PROPERTY.path, cls: 'home' },
  { id: 'petronas', label: 'Petronas Twin Towers', href: '/views/#petronas', cls: '' },
  { id: 'kl-tower', label: 'KL Tower', href: '/views/#kl-tower', cls: 'minor' },
  { id: 'merdeka', label: 'Merdeka 118', href: '/views/#merdeka', cls: 'minor' },
];
---
<!doctype html>
<html lang="en-MY" transition:animate="none">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Kozi" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#05070D" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preload" href={display} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={sans} as="font" type="font/woff2" crossorigin />
  <Fragment set:html={`<style>${fonts}</style>`} />
  <script is:inline>
    // Before first paint: mark JS and reduced motion, and skip an intro already seen this visit.
    (function () {
      var d = document.documentElement, rm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      d.classList.add('js'); if (rm) d.classList.add('rm');
      try { if (rm || sessionStorage.getItem('kozi-intro')) d.classList.add('no-intro'); } catch (e) { d.classList.add('no-intro'); }
      setTimeout(function () { if (!window.__kozi) d.classList.add('js-late'); }, 4000);
    })();
  </script>
  <ClientRouter />
  {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <div class="stage" data-stage transition:persist="city" aria-hidden="true">
    <picture class="still">
      <source media="(orientation: portrait)" srcset="/city/v3/still-tall.jpg" />
      <img src="/city/v3/still-wide.jpg" alt="" width="1600" height="1000" fetchpriority="high" decoding="async" />
    </picture>
    <canvas></canvas>
    <div class="veil"></div>
    <div class="pins" data-pins>
      {pinList.map((p) => <a class:list={['pin', p.cls]} data-pin={p.id} href={p.href} tabindex="-1" hidden><b>{p.label}</b><i></i></a>)}
    </div>
  </div>
  {intro && (
    <div class="intro" data-intro aria-hidden="true">
      <div><AnimLogo id="intro" /><p class="tag" data-intro-tag>{BRAND.tagline}</p></div>
    </div>
  )}
  <Top />
  <main id="main" class="page" data-cam={cam} data-pins={pins} data-hi={hi?.join(',') || undefined} data-dim={dim ? '' : undefined} data-touch={touch ? '' : undefined} transition:animate="fade">
    <slot />
  </main>
  <Foot />
  <script>
    import '@my/scripts/night';
  </script>
</body>
</html>
