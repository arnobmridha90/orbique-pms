---
// A suite page: the photos, what the suite is like, the view, what's included, the rules,
// and the booking card with live prices beside it all the way down.
import { getImage } from 'astro:assets';
import Layout from '@shared/components/Layout.astro';
import Gallery from '@shared/components/Gallery.astro';
import BookCard from '@shared/components/BookCard.astro';
import Photo from '@shared/components/Photo.astro';
import { AMENITIES, BRAND, NEARBY, PROPERTY, POLICIES, SUITES, VIEWS, VIEW_PHOTOS, photo, type Suite } from '@shared/data/kozi';
import { ICONS } from '@shared/data/icons';
import { crumbsLd, lodgingLd, suiteLd } from '@shared/lib/seo';

export function getStaticPaths() {
  return SUITES.map((s) => ({ params: { suite: s.id }, props: { suite: s } }));
}
const { suite } = Astro.props as { suite: Suite };
const order = ['boutique', 'premium', 'standard'];
const others = order.filter((id) => id !== suite.id).map((id) => SUITES.find((s) => s.id === id)!);
const crumbs = [{ name: 'Kuala Lumpur', path: '/kuala-lumpur/' }, { name: PROPERTY.name, path: PROPERTY.path }, { name: suite.name, path: `${PROPERTY.path}${suite.id}/` }];
const og = suite.hasPhotos ? await getImage({ src: photo(suite.photos[0].key), width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 78 }) : null;
const ogAbs = og ? new URL(og.src, BRAND.my).href : undefined;
const views = suite.views.map((v) => ({ id: v, name: VIEWS[v].name, shot: (VIEW_PHOTOS as Record<string, { key: string; alt: string; from: string; suites: string[] }[]>)[v]?.find((p) => p.suites.includes(suite.id)) }));
const facts = [
  { icon: 'bed', k: '2 bedrooms', v: 'A queen room, and a room with a queen and a single' },
  { icon: 'bath', k: '2 bathrooms', v: 'Hair dryer and iron in the suite' },
  { icon: 'guests', k: 'Sleeps 4', v: 'A 5th guest on an extra bed' },
  { icon: 'level', k: suite.levels, v: PROPERTY.building },
];
const maps = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent('Vortex Suites KLCC, Jalan Sultan Ismail, Kuala Lumpur');
const title = `${suite.name} at Vortex KLCC, Kuala Lumpur | Kozi`;
const description = `${suite.name} at Kozi @ Vortex KLCC: two bedrooms, two bathrooms and a full kitchen for four in central Kuala Lumpur. ${suite.line} See live prices and book direct.`;
---
<Layout site="my" title={title} description={description} image={og?.src} noindex={!suite.hasPhotos}
  jsonld={[crumbsLd(BRAND.my, crumbs), lodgingLd, suiteLd(suite, ogAbs)]}>
  <div class="wrap sp-top">
    <nav class="crumbs sp-crumbs" aria-label="Breadcrumb">
      <ol>{crumbs.map((c, i) => <li>{i < crumbs.length - 1 ? <a href={c.path}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>)}</ol>
    </nav>
    <div class="sp-title">
      <div>
        <p class="eyebrow">{PROPERTY.name} · {suite.levels}</p>
        <h1 class="display sp-h" data-split>{suite.name.replace(' Suite', '')} <em>Suite</em></h1>
      </div>
      <p class="sp-line">{suite.line}</p>
    </div>
    <Gallery photos={suite.photos} name={suite.name} note={suite.hasPhotos ? undefined : 'Suite photos are on the way'} />
  </div>

  <div class="wrap sp-body">
    <div class="sp-main">
      <ul class="sp-facts" role="list">
        {facts.map((f) => (
          <li><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS[f.icon]} /><b>{f.k}</b><span>{f.v}</span></li>
        ))}
      </ul>

      <section class="sp-sec" aria-labelledby="sp-about">
        <h2 id="sp-about" class="display sp-h2">About the suite</h2>
        <p class="sp-story">{suite.story}</p>
        <ul class="sp-chips" role="list">{suite.highlights.map((h) => <li>{h}</li>)}</ul>
      </section>

      <section class="sp-sec" aria-labelledby="sp-sleep">
        <h2 id="sp-sleep" class="display sp-h2">Where you'll sleep</h2>
        <ul class="sp-beds" role="list">
          <li><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS.queen} /><b>Bedroom 1</b><span>Queen bed</span></li>
          <li><span class="sp-bed2"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS.queen} /><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS.single} /></span><b>Bedroom 2</b><span>Queen bed and a single bed</span></li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS.single} /><b>A fifth guest</b><span>Extra bed, RM60 a night</span></li>
        </ul>
      </section>

      {views.length > 0 && (
        <section class="sp-sec" aria-labelledby="sp-view">
          <h2 id="sp-view" class="display sp-h2">The view</h2>
          <p class="sp-p">{suite.id === 'premium'
            ? 'There are two Premium Suites, on levels 26 and 47. Between them they look out on the Twin Towers, KL Tower and Merdeka 118, and which you see depends on the suite.'
            : `From the windows: ${views.map((v) => v.name).join(' and ')}.`}</p>
          <div class="sp-views">
            {views.filter((v) => v.shot).map((v) => (
              <figure class="sp-view" data-reveal>
                <Photo k={v.shot!.key} alt={v.shot!.alt} sizes="(max-width: 760px) 92vw, 30vw" widths={[480, 720, 960]} />
                <figcaption><b>{v.name}</b><span>{v.shot!.from}</span></figcaption>
              </figure>
            ))}
          </div>
        </section>
      )}

      <section class="sp-sec" aria-labelledby="sp-in">
        <h2 id="sp-in" class="display sp-h2">In the suite</h2>
        <ul class="sp-amen" role="list">
          {AMENITIES.map((a) => (
            <li><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS[a.icon]} /><div><b>{a.title}</b><span>{a.text}</span></div></li>
          ))}
        </ul>
      </section>

      <section class="sp-sec" aria-labelledby="sp-know">
        <h2 id="sp-know" class="display sp-h2">Good to know</h2>
        <dl class="sp-rules">
          <div><dt>Check-in</dt><dd>From {PROPERTY.checkIn}, with your own door code.</dd></div>
          <div><dt>Check-out</dt><dd>By {PROPERTY.checkOut}.</dd></div>
          <div><dt>Cancellation</dt><dd>{POLICIES.cancel}</dd></div>
          <div><dt>House rules</dt><dd>{POLICIES.rules}</dd></div>
          <div><dt>Tourism tax</dt><dd>{POLICIES.tax}</dd></div>
          <div><dt>Pool and gym</dt><dd>{POLICIES.paid}</dd></div>
        </dl>
      </section>

      <section class="sp-sec" aria-labelledby="sp-near">
        <h2 id="sp-near" class="display sp-h2">Around Vortex</h2>
        <p class="sp-p">{PROPERTY.building}, {PROPERTY.address}. In the Golden Triangle, between KLCC and Bukit Bintang.</p>
        <ul class="sp-near" role="list">
          {NEARBY.map((n) => <li><b>{n.name}</b><span>{n.what}</span></li>)}
        </ul>
        <a class="sp-map" href={maps} rel="noopener" target="_blank"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS.pin} />Open in Google Maps <span aria-hidden="true">↗</span></a>
      </section>
    </div>
    <BookCard suite={suite} />
  </div>

  <section class="sp-others" aria-labelledby="sp-others-h">
    <div class="wrap">
      <p class="eyebrow">Also at Vortex KLCC</p>
      <h2 id="sp-others-h" class="display h3" data-split>The other <em>suites.</em></h2>
      <ul class="sp-ocards" role="list">
        {others.map((o) => (
          <li data-reveal>
            <a class="sp-ocard" href={`${PROPERTY.path}${o.id}/`}>
              <div class="sp-omedia"><Photo k={o.photos[0].key} alt="" sizes="(max-width: 760px) 92vw, 44vw" widths={[480, 720, 960]} />{!o.hasPhotos && <span class="gl-note">Suite photos are on the way</span>}</div>
              <div class="sp-obody"><p class="sp-olevel">{o.levels}</p><h3 class="display">{o.name}</h3><p>{o.line}</p><span class="sp-omore">See the suite <span aria-hidden="true">→</span></span></div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<style>
  .sp-top { padding-top: calc(var(--hd-h) + 26px); }
  .sp-crumbs { color: var(--ink-2); }
  .sp-title { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr); align-items: end; gap: 24px 60px; margin: 22px 0 30px; }
  .sp-h { font-size: clamp(48px, 6.6vw, 104px); margin-top: 18px; }
  .sp-line { margin: 0; max-width: 24.15em; justify-self: end; font: 400 clamp(19px, 1.6vw, 24px)/1.4 var(--display); font-variation-settings: var(--soft); color: var(--ink-2); }
  .sp-body { display: grid; grid-template-columns: minmax(0, 1fr) minmax(340px, 400px); gap: clamp(40px, 6vw, 110px); padding: clamp(40px, 5vw, 64px) 0 clamp(80px, 9vw, 140px); }
  .sp-facts { list-style: none; margin: 0; padding: 0 0 34px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; border-bottom: 1px solid var(--line); }
  .sp-facts li { display: grid; gap: 6px; align-content: start; }
  .sp-facts svg, .sp-beds svg, .sp-amen svg, .sp-map svg { width: 26px; height: 26px; fill: none; stroke: var(--amber-deep); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .sp-facts b { margin-top: 6px; font-weight: 650; font-size: 16px; }
  .sp-facts span { font-size: 14px; line-height: 1.45; color: var(--muted); }
  .sp-sec { padding: 44px 0; border-bottom: 1px solid var(--line); }
  .sp-sec:last-child { border-bottom: 0; }
  .sp-h2 { font-size: clamp(30px, 2.8vw, 42px); line-height: 1.05; margin-bottom: 18px; }
  .sp-story { margin: 0; max-width: 35.65em; font-size: 18px; line-height: 1.65; color: var(--ink-2); }
  .sp-p { margin: 0 0 22px; max-width: 35.65em; color: var(--ink-2); }
  .sp-chips { list-style: none; margin: 22px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .sp-chips li { padding: 9px 14px; border-radius: 999px; background: var(--paper); box-shadow: inset 0 0 0 1px var(--line); font: 600 13.5px/1 var(--sans); }
  .sp-beds { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .sp-beds li { display: grid; gap: 4px; padding: 20px; border-radius: 20px; background: var(--paper); box-shadow: inset 0 0 0 1px var(--line); }
  .sp-beds li > svg, .sp-bed2 { margin-bottom: 12px; }
  .sp-bed2 { display: flex; gap: 4px; }
  .sp-beds b { font-weight: 650; } .sp-beds span { font-size: 14.5px; color: var(--muted); }
  .sp-views { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; }
  .sp-view { margin: 0; position: relative; border-radius: 20px; overflow: hidden; aspect-ratio: 4 / 5; background: var(--night); }
  .sp-view:only-child { aspect-ratio: 16 / 10; }
  .sp-view :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .sp-view figcaption { position: absolute; inset: auto 0 0; display: grid; gap: 2px; padding: 40px 16px 14px; color: var(--cream); background: linear-gradient(to top, rgb(14 12 18 / 0.78), transparent); }
  .sp-view b { font: 400 20px/1.1 var(--display); font-variation-settings: var(--soft); }
  .sp-view span { font-size: 13px; opacity: 0.8; }
  .sp-amen { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 32px; }
  .sp-amen li { display: grid; grid-template-columns: 26px 1fr; gap: 16px; }
  .sp-amen b { display: block; font-weight: 650; } .sp-amen span { display: block; margin-top: 3px; font-size: 15px; color: var(--muted); line-height: 1.5; }
  .sp-rules { margin: 0; display: grid; gap: 0; }
  .sp-rules div { display: grid; grid-template-columns: 170px 1fr; gap: 20px; padding: 14px 0; border-top: 1px solid var(--line); }
  .sp-rules div:first-child { border-top: 0; padding-top: 0; }
  .sp-rules dt { font-weight: 650; } .sp-rules dd { margin: 0; color: var(--ink-2); }
  .sp-near { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 32px; }
  .sp-near li { display: grid; gap: 2px; padding: 14px 0; border-top: 1px solid var(--line); }
  .sp-near b { font-weight: 650; } .sp-near span { font-size: 14.5px; color: var(--muted); }
  .sp-map { display: inline-flex; align-items: center; gap: 10px; margin-top: 24px; font-weight: 650; border-bottom: 1px solid var(--amber); padding-bottom: 3px; }
  .sp-map svg { width: 20px; height: 20px; }

  .sp-others { padding: clamp(80px, 9vw, 130px) 0; background: var(--paper); border-top: 1px solid var(--line); }
  .sp-others .h3 { margin: 18px 0 40px; }
  .sp-ocards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .sp-ocard { display: grid; grid-template-columns: 1fr 1fr; border-radius: 26px; overflow: hidden; background: var(--cream); box-shadow: inset 0 0 0 1px var(--line); transition: transform 300ms var(--ease-out), box-shadow 300ms ease; }
  .sp-ocard:active { transform: scale(0.99); }
  .sp-omedia { position: relative; min-height: 260px; background: var(--sand); }
  .sp-omedia :global(picture), .sp-omedia :global(img) { width: 100%; height: 100%; }
  .sp-omedia :global(img) { object-fit: cover; position: absolute; inset: 0; transition: transform 700ms var(--ease-out); }
  .sp-obody { padding: 26px; display: grid; align-content: start; gap: 8px; }
  .sp-olevel { margin: 0; font: 650 11px/1 var(--sans); letter-spacing: 0.16em; text-transform: uppercase; color: var(--amber-deep); }
  .sp-obody h3 { font-size: 32px; margin: 6px 0 2px; }
  .sp-obody p:not(.sp-olevel) { margin: 0; font-size: 15px; color: var(--ink-2); }
  .sp-omore { margin-top: 10px; font-weight: 650; font-size: 14.5px; }
  .sp-omore span { display: inline-block; transition: transform 200ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .sp-ocard:hover { box-shadow: inset 0 0 0 1px rgb(43 38 34 / 0.2), 0 30px 60px -40px rgb(43 38 34 / 0.5); }
    .sp-ocard:hover .sp-omedia :global(img) { transform: scale(1.04); }
    .sp-ocard:hover .sp-omore span { transform: translateX(3px); }
    .sp-map:hover { border-color: var(--ink); }
  }

  @media (max-width: 1100px) {
    .sp-ocards { grid-template-columns: 1fr; }
  }
  @media (max-width: 900px) {
    .sp-title { grid-template-columns: 1fr; margin-bottom: 22px; }
    .sp-line { justify-self: start; }
    .sp-body { grid-template-columns: 1fr; padding-top: 30px; }
    .sp-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 18px; }
  }
  @media (max-width: 760px) {
    .sp-top { padding-top: calc(var(--hd-h) + 16px); }
    .sp-body { padding-bottom: 120px; }
    .sp-beds { grid-template-columns: 1fr; }
    .sp-amen, .sp-near { grid-template-columns: 1fr; }
    .sp-rules div { grid-template-columns: 1fr; gap: 4px; }
    .sp-ocard { grid-template-columns: 1fr; }
    .sp-omedia { min-height: 0; aspect-ratio: 16 / 10; }
  }
</style>
