---
// After payment: the booking reference, the stay, and what happens between now and the door code.
import Layout from '@shared/components/Layout.astro';
import { BRAND, GUIDES, PROPERTY } from '@shared/data/kozi';
import { ICONS } from '@shared/data/icons';
const mdac = GUIDES.find((g) => g.slug.startsWith('mdac'))!;
const klia = GUIDES.find((g) => g.slug.startsWith('klia'))!;
---
<Layout site="my" title="Your Kozi booking" description="Your Kozi booking is confirmed." noindex>
  <section class="wrap bc" data-confirmed>
    <div class="bc-sun" aria-hidden="true"><span></span></div>
    <p class="eyebrow bc-k" data-bc-k>Booking confirmed</p>
    <h1 class="display bc-h"><span data-bc-h>You're booked.</span></h1>
    <p class="bc-ref">Reference <b data-bc-ref>—</b> <button type="button" class="s-link" data-bc-copy>Copy</button></p>
    <p class="bc-test" data-bc-test hidden>Test mode: no payment was taken and no room is held.</p>

    <div class="bc-grid">
      <dl class="bc-stay">
        <div><dt>Suite</dt><dd data-bc-suite>—</dd></div>
        <div><dt>Check-in</dt><dd><span data-bc-in>—</span><small>from {PROPERTY.checkIn}</small></dd></div>
        <div><dt>Check-out</dt><dd><span data-bc-out>—</span><small>by {PROPERTY.checkOut}</small></dd></div>
        <div><dt>Guests</dt><dd data-bc-guests>—</dd></div>
        <div><dt>Where</dt><dd>{PROPERTY.building}<small>{PROPERTY.address}</small></dd></div>
      </dl>
      <div>
        <h2 class="display bc-h2">What happens next</h2>
        <ol class="bc-steps" role="list">
          <li><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS.mail} /><div><b>Keep your reference</b><span>It's at the top of this page. Copy it, or add the stay to your calendar below.</span></div></li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS.leaf} /><div><b>Visiting from abroad?</b><span>Fill in the free MDAC arrival card in the 3 days before you land. <a href={`/guides/${mdac.slug}/`}>Read our MDAC guide</a>.</span></div></li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS.key} /><div><b>Your door code</b><span>On arrival day it reaches you 30 minutes before {PROPERTY.checkIn}, so you can let yourself in.</span></div></li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS.chat} /><div><b>Questions before then?</b><span>Email <a href={`mailto:${BRAND.email}`}>{BRAND.email}</a>. We reply in English, Bahasa Malaysia and Bahasa Indonesia.</span></div></li>
        </ol>
        <div class="bc-go">
          <button type="button" class="btn" data-bc-ics><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS.clock} />Add to my calendar</button>
          <a class="btn ghost bc-ghost" href={`/guides/${klia.slug}/`}>Getting here from KLIA <span class="arr" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .bc { position: relative; padding: calc(var(--hd-h) + clamp(50px, 8vw, 110px)) 0 clamp(90px, 10vw, 150px); }
  /* a small sunrise, like the O in the logo, comes up as the page opens */
  .bc-sun { position: relative; width: 92px; aspect-ratio: 2 / 1; overflow: hidden; margin-bottom: 30px; pointer-events: none; }
  .bc-sun span { position: absolute; left: 14%; right: 14%; top: 28%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, var(--amber-hi), var(--amber) 72%);
    box-shadow: 0 0 40px 6px rgb(240 184 96 / 0.35); transform: translateY(100%); animation: bcrise 1.4s var(--ease-out) 0.2s forwards; }
  .bc-sun::after { content: ''; position: absolute; inset: auto 0 0; height: 2px; border-radius: 2px; background: var(--ink); }
  @keyframes bcrise { to { transform: translateY(0); } }
  .bc-h { font-size: clamp(52px, 8vw, 128px); margin: 20px 0 0; max-width: 6.9em; }
  .bc-h em { color: var(--amber); }
  .bc-ref { margin: 22px 0 0; font-size: 16px; color: var(--ink-2); }
  .bc-ref b { font: 650 18px/1 var(--sans); letter-spacing: 0.06em; color: var(--ink); margin-right: 6px; }
  .bc-test { display: inline-block; margin: 18px 0 0; padding: 10px 14px; border-radius: 12px; background: rgb(200 134 46 / 0.1); color: var(--amber-deep); font: 600 13px/1.4 var(--sans); }
  .bc-grid { display: grid; grid-template-columns: minmax(300px, 0.8fr) minmax(0, 1.2fr); gap: clamp(36px, 6vw, 100px); margin-top: clamp(40px, 6vw, 80px); align-items: start; }
  .bc-stay { margin: 0; padding: 8px 26px; border-radius: 26px; background: var(--paper); box-shadow: inset 0 0 0 1px var(--line); }
  .bc-stay div { display: grid; grid-template-columns: 110px 1fr; gap: 16px; padding: 16px 0; border-top: 1px solid var(--line); }
  .bc-stay div:first-child { border-top: 0; }
  .bc-stay dt { font: 650 10.5px/20px var(--sans); letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
  .bc-stay dd { margin: 0; font-weight: 600; }
  .bc-stay small { display: block; margin-top: 2px; font-weight: 500; font-size: 13.5px; color: var(--muted); }
  .bc-h2 { font-size: clamp(30px, 2.8vw, 42px); margin-bottom: 24px; }
  .bc-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; }
  .bc-steps li { display: grid; grid-template-columns: 26px 1fr; gap: 16px; }
  .bc-steps svg, .bc-go svg { width: 24px; height: 24px; fill: none; stroke: var(--amber-deep); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .bc-go svg { width: 19px; height: 19px; stroke: currentColor; }
  .bc-steps b { display: block; font-weight: 650; }
  .bc-steps span { display: block; margin-top: 3px; color: var(--ink-2); }
  .bc-steps a { border-bottom: 1px solid var(--amber); }
  .bc-go { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }
  .bc-ghost { color: var(--ink); }
  @media (hover: hover) and (pointer: fine) { .bc-ghost:hover { background: rgb(43 38 34 / 0.05); } }
  @media (max-width: 860px) { .bc-grid { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .bc-sun span { animation: none; transform: none; } }
</style>
